{
    "name": "Blue Flash Mobile",
    "short_name": "Blue Flash Mobile",
    "start_url": "/blueFlashMobile/",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#2d7ef7",
    "icons": [
        {
            "src": "./assets/apple-touch-icon.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "./assets/apple-touch-icon.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "headers": [
        {
            "source": "**/*.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "**/*.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                }
            ]
        }
    ]
}